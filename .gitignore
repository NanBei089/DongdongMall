# Java / Maven：编译输出和打包产物
target/
out/
*.class
*.jar
*.war
*.ear
# Maven Wrapper 的启动 JAR 属于项目工具，需要保留
!**/.mvn/wrapper/maven-wrapper.jar

# 前端
front/
node_modules/
dist/
.vite/
*.tsbuildinfo

# 测试报告和覆盖率
coverage/
test-results/
playwright-report/
playwright/.cache/

# 运行日志与 JVM 诊断文件
logs/
*.log
*.pid
*.pid.lock
hs_err_pid*
replay_pid*
*.hprof
*.jfr

# 本地环境变量；保留可提交的示例和模板
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Spring 本地配置；公共 application.yml 和示例文件正常提交
**/application-dev.yml
**/application-dev.yaml
**/application-local.yml
**/application-local.yaml

# IDE 本地配置
.idea/
.vscode/
*.iml
*.ipr
*.iws

# 操作系统文件与编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# 本地代理工作约定
AGENTS.md
