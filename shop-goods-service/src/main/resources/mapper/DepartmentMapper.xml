<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nanbei.mapper.DepartmentMapper">

    <!--t_department 数据库操作映射文件-->
    <resultMap id="BaseResultMap" type="com.nanbei.pojo.Department">

            <id property="id" column="id" />

            <result property="name" column="name" />
            <result property="dirPath" column="dir_path" />
            <result property="parentId" column="parent_id" />

    </resultMap>


    <!--基础查询字段列表-->
    <sql id="Base_Column_List">
        id,name,dir_path,parent_id
    </sql>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from t_department where id = #{id}
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_department
        where
        <choose>
            <when test="ids != null and ids.size() > 0">
                id in
                <foreach item="id" collection="ids" separator="," open="(" close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>1 = 0</otherwise>
        </choose>
    </select>

    <update id="updateChildrenPath">

        UPDATE t_department

        SET dir_path = CONCAT(
        #{newPath},
        SUBSTRING(dir_path, CHAR_LENGTH(#{oldPath}) + 1)
        )

        WHERE dir_path LIKE CONCAT(#{oldPath}, '/%')

    </update>


    <!--选择性查询-->
    <select id="selectBySelective"
            parameterType="com.nanbei.pojo.Department"
            resultMap="BaseResultMap">

        select
        <include refid="Base_Column_List"/>

        from t_department
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="name != null">
                and name = #{name}
            </if>
            <if test="dirPath != null">
                and dir_path = #{dirPath}
            </if>
            <if test="parentId != null">
                and parent_id = #{parentId}
            </if>
        </where>
        order by id
    </select>




    <!--根据主键ID删除指定的数据记录-->
    <delete id="deleteByPrimaryKey"
            parameterType="java.lang.Long">

        delete from t_department

        where  id = #{id} 

    </delete>



    <!--
        插入实体对象对应的全部字段
        包括值为 null 的字段
    -->
    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.nanbei.pojo.Department" useGeneratedKeys="true">

        insert into t_department

        (
        id,name,dir_path,parent_id
        )

        values (
        #{id},#{name},#{dirPath},#{parentId}
        )

    </insert>


    <!--
        选择性新增
        未提供的字段可以使用数据库设置的默认值
    -->
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.nanbei.pojo.Department" useGeneratedKeys="true">

        insert into t_department

        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">
                    id,
                </if>
                <if test="name != null">
                    name,
                </if>
                <if test="dirPath != null">
                    dir_path,
                </if>
                <if test="parentId != null">
                    parent_id,
                </if>
        </trim>

        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">
                    #{id},
                </if>
                <if test="name != null">
                    #{name},
                </if>
                <if test="dirPath != null">
                    #{dirPath},
                </if>
                <if test="parentId != null">
                    #{parentId},
                </if>
        </trim>

    </insert>


    <!--根据主键选择性修改-->
    <update id="updateByPrimaryKeySelective"
            parameterType="com.nanbei.pojo.Department">

        update t_department

        <set>
                <if test="name != null">
                    name = #{name},
                </if>
                <if test="dirPath != null">
                    dir_path = #{dirPath},
                </if>
                <if test="parentId != null">
                    parent_id = #{parentId},
                </if>
        </set>

        where  id = #{id} 

    </update>


    <!--根据主键修改-->
    <update id="updateByPrimaryKey"
            parameterType="com.nanbei.pojo.Department">

        update t_department

        set 
            name = #{name},
            dir_path = #{dirPath},
            parent_id = #{parentId}

        where  id = #{id} 

    </update>

    <delete id="deleteByDirPaths">
        DELETE FROM t_department
        WHERE
        <choose>
            <when test="paths != null and paths.size() > 0">
                <foreach collection="paths" item="path" separator=" OR ">
                    (dir_path = #{path} OR dir_path LIKE CONCAT(#{path}, '/%'))
                </foreach>
            </when>
            <otherwise>1 = 0</otherwise>
        </choose>
    </delete>

    <update id="updateDescendantPaths">
        update t_department
        set dir_path = CONCAT(#{newPath}, SUBSTRING(dir_path, CHAR_LENGTH(#{oldPath}) + 1))
        where dir_path LIKE CONCAT(#{oldPath}, '/%')
    </update>
</mapper>
