<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nanbei.goods.mapper.SpecificationOptionMapper">

    <resultMap id="BaseResultMap" type="com.nanbei.pojo.SpecificationOption">
            <id property="id" column="id" />
            <result property="optionName" column="option_name" />
            <result property="specId" column="spec_id" />
            <result property="orders" column="orders" />
    </resultMap>

    <sql id="Base_Column_List">
        id,option_name,spec_id,orders
    </sql>

    <!--根据spec_id删除-->
    <delete id="deleteBySpecId" parameterType="java.lang.Long">
        delete from tb_specification_option where spec_id = #{specId}
    </delete>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from tb_specification_option
        where  id = #{id} 
    </select>

    <select id="selectBySpecId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from tb_specification_option
        where spec_id = #{specId}
        order by orders, id
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from tb_specification_option
        where  id = #{id} 
    </delete>

<!--    批量删除-->
    <delete id="deleteBatch" parameterType="java.util.List">
        delete from tb_specification_option where spec_id in
        <foreach item="spec_id" collection="ids" open="(" close=")" separator=",">
            #{spec_id}
        </foreach>
    </delete>

    <insert id="insertOption" keyColumn="id" keyProperty="id" parameterType="java.util.List" useGeneratedKeys="true">
        insert into tb_specification_option
        (option_name, spec_id, orders)
        values
        <foreach collection="record" item="item" separator=",">
            (#{item.optionName}, #{item.specId}, #{item.orders})
        </foreach>
    </insert>

    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.nanbei.pojo.SpecificationOption" useGeneratedKeys="true">
        insert into tb_specification_option
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="optionName != null">option_name,</if>
                <if test="specId != null">spec_id,</if>
                <if test="orders != null">orders,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="optionName != null">#{optionName},</if>
                <if test="specId != null">#{specId},</if>
                <if test="orders != null">#{orders},</if>
        </trim>
    </insert>


    <update id="updateOption" parameterType="java.util.List">
        <foreach collection="record" item="item" separator=";">
            update tb_specification_option
            <set>
                <if test="item.optionName != null">
                    option_name = #{item.optionName},
                </if>
                <if test="item.orders != null">
                    orders = #{item.orders},
                </if>
            </set>
            where id = #{item.id}
        </foreach>
    </update>


    <update id="updateByPrimaryKey" parameterType="com.nanbei.pojo.SpecificationOption">
        update tb_specification_option
        set 
            option_name =  #{optionName},
            orders =  #{orders}
        where   id = #{id} and spec_id = #{specId}
    </update>
</mapper>
