<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nanbei.mapper.SpecificationMapper">

    <resultMap id="BaseResultMap" type="com.nanbei.pojo.Specification">
            <id property="id" column="id" />
            <result property="specName" column="spec_name" />
    </resultMap>

    <sql id="Base_Column_List">
        id,spec_name
    </sql>

    <!-- 分页查询操作 -->
    <select id="selectList" parameterType="com.nanbei.vo.SpecificationVo" resultType="com.nanbei.pojo.Specification">
        select
        <include refid="Base_Column_List" />
        from tb_specification
        <where>
            <if test="specName != null and specName != ''">
                and spec_name like CONCAT('%',#{specName},'%')
            </if>
        </where>
        order by id
    </select>

    <!-- 查询操作 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from tb_specification
        where  id = #{id} 
    </select>

    <!-- 删除操作 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from tb_specification
        where  id = #{id} 
    </delete>
    <!-- 插入操作 -->
    <insert id="insertSpecification" keyColumn="id" keyProperty="id" parameterType="com.nanbei.pojo.Specification" useGeneratedKeys="true">
        insert into tb_specification
        (spec_name)
        values (#{specName})
    </insert>

    <!-- 更新操作 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.nanbei.pojo.Specification">
        update tb_specification
        <set>
                <if test="specName != null">
                    spec_name = #{specName},
                </if>
        </set>
        where   id = #{id} 
    </update>
    <!-- 更新操作 -->
    <update id="updateByPrimaryKey" parameterType="com.nanbei.pojo.Specification">
        update tb_specification
        set 
            spec_name =  #{specName}
        where   id = #{id} 
    </update>

    <!--    批量删除-->
    <delete id="deleteBatch" parameterType="java.util.List">
        delete from tb_specification where id in
        <foreach item="id" collection="ids" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
</mapper>
